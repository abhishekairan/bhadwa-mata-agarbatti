# Copy to .env to override. PORT applies to `npm run dev` and `npm run preview`.
PORT=3000

# Public address of the live site, no trailing slash. Read at BUILD time, so also set it in your
# host's build environment. Enables canonical links, og:url and og:image; sitemap.xml and
# robots.txt fall back to the request's own domain when this is unset.
# VITE_SITE_URL=https://www.your-domain.com
